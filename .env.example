# Copy this file to .env and fill in your values
# NEVER commit .env or .env.local to GitHub

# === Vite Frontend ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# === Next.js Frontend (if applicable) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# === Express Server ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# === JWT Secret (generate a long random string for production) ===
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-min-32-chars

# === Server Port (optional, default 5000) ===
PORT=5000
